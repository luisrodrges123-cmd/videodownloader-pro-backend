PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=*

# Conekta: solo la llave privada es secreta; no publiques credenciales reales.
CONEKTA_PRIVATE_KEY=
CONEKTA_PUBLIC_KEY=
CONEKTA_WEBHOOK_PUBLIC_KEY=

MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
PUBLIC_APP_URL=https://luisrodrges123-cmd.github.io/videodownloader-pro-backend/

# WhatsApp Business Cloud API — guarda los valores reales como secretos en Render.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
WHATSAPP_TEMPLATE_NAME=admin_activity_alert
WHATSAPP_TEMPLATE_LANGUAGE=es_MX
WHATSAPP_GRAPH_API_VERSION=v27.0
APP_TIMEZONE=America/Chihuahua

# Asistente web basado en el bot de Ventas Lobo Store. Guarda la clave solo en Render.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
